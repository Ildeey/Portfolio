# Copy this file to .env and fill in the values

# Port (Railway/Render set this automatically)
PORT=3000

# REQUIRED: Change this to a strong random string!
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=changeme-in-production

# Path to JSON database file (default: ./submissions.json)
# DB_PATH=./submissions.json

# Optional: restrict CORS to your domain
# ALLOWED_ORIGIN=https://your-domain.com
